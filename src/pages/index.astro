---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Sell My House Fast Baltimore | Alberti Home Buyers">
  <!-- HERO SECTION -->
  <section class="py-32 bg-white">
    <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <h1 class="text-6xl md:text-7xl font-black mb-8 text-brand-purple leading-tight">Sell Your House Fast</h1>
      <p class="text-2xl text-gray-600 mb-8 leading-relaxed">Get a fair cash offer in 24 hours. No repairs. No fees. No waiting.</p>
      <p class="mb-12"><a href="tel:443-327-9292" class="hero-phone hover:underline">📞 443-327-9292</a></p>

      <div class="flex flex-col sm:flex-row gap-6 justify-center">
        <a href="#form" class="inline-block bg-brand-sky text-white px-12 py-4 rounded-lg font-bold text-lg hover:bg-brand-teal transition-all">
          Get Free Offer
        </a>
        <a href="tel:443-327-9292" class="inline-block bg-brand-sky text-white px-12 py-4 rounded-lg font-bold text-lg hover:bg-brand-teal transition-all">
          Call 443-327-9292
        </a>
      </div>
    </div>
  </section>

  <!-- FORM SECTION -->
  <section class="py-24 bg-gray-50">
    <div class="max-w-2xl mx-auto px-4 sm:px-6 lg:px-8">
      <h2 class="text-4xl font-black text-center mb-12 text-brand-purple">Get Your Free Offer</h2>
      <form id="form" class="space-y-6" action="https://formspree.io/f/xjybgbry" method="POST">
        <input type="text" name="name" placeholder="Your Name" required class="w-full px-6 py-3 border border-gray-300 rounded-lg focus:outline-none focus:border-brand-sky focus:ring-2 focus:ring-brand-sky/30" />
        <input type="email" name="email" placeholder="Your Email" required class="w-full px-6 py-3 border border-gray-300 rounded-lg focus:outline-none focus:border-brand-sky focus:ring-2 focus:ring-brand-sky/30" />
        <input type="tel" name="phone" placeholder="Your Phone" required class="w-full px-6 py-3 border border-gray-300 rounded-lg focus:outline-none focus:border-brand-sky focus:ring-2 focus:ring-brand-sky/30" />
        <input type="text" name="address" placeholder="Property Address" required class="w-full px-6 py-3 border border-gray-300 rounded-lg focus:outline-none focus:border-brand-sky focus:ring-2 focus:ring-brand-sky/30" />
        <button type="submit" class="w-full bg-brand-sky text-white font-bold py-3 rounded-lg hover:bg-brand-teal transition-all text-lg">
          Get Free Offer
        </button>
      </form>
      <p class="text-center text-gray-600 mt-8">Or call <a href="tel:443-327-9292" class="text-brand-sky font-bold hover:underline">443-327-9292</a></p>
    </div>
  </section>

  <!-- CREDIBILITY SECTION -->
  <section class="py-24 bg-brand-purple text-white">
    <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 md:grid-cols-4 gap-8 text-center">
        <div>
          <div class="text-5xl font-black mb-2">500+</div>
          <p class="text-brand-sky font-bold">Happy Customers</p>
        </div>
        <div>
          <div class="text-5xl font-black mb-2">$50M+</div>
          <p class="text-brand-sky font-bold">In Cash Offers</p>
        </div>
        <div>
          <div class="text-5xl font-black mb-2">15+</div>
          <p class="text-brand-sky font-bold">Years Experience</p>
        </div>
        <div>
          <div class="text-5xl font-black mb-2">A+</div>
          <p class="text-brand-sky font-bold">BBB Rating</p>
        </div>
      </div>
    </div>
  </section>

  <!-- FEATURES SECTION -->
  <section class="py-24 bg-white">
    <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 md:grid-cols-3 gap-12 text-center">
        <div>
          <h3 class="text-2xl font-black text-brand-purple mb-4">24 Hours</h3>
          <p class="text-gray-600">Get a fair cash offer within one day</p>
          
        </div>
        <div>
          <h3 class="text-2xl font-black text-brand-purple mb-4">7 Days</h3>
          <p class="text-gray-600">Close in as little as one week</p>
          
        </div>
        <div>
          <h3 class="text-2xl font-black text-brand-purple mb-4">$0 Fees</h3>
          <p class="text-gray-600">No commissions or hidden costs</p>
          
        </div>
      </div>
<p class="text-center mt-12"><a href="tel:443-327-9292" class="hero-phone hover:underline">📞 443-327-9292</a></p>
    </div>
  </section>

  <!-- WHY US SECTION -->
  <section class="py-24 bg-gray-50">
    <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <h2 class="text-4xl font-black text-brand-purple mb-12">Why Choose Alberti?</h2>

      <div class="space-y-6 text-center mb-12">
        <div class="flex items-center justify-center gap-4">
          <span class="text-2xl text-brand-sky">✓</span>
          <p class="text-gray-700">Buy as-is, no repairs needed</p>
        </div>
        <div class="flex items-center justify-center gap-4">
          <span class="text-2xl text-brand-sky">✓</span>
          <p class="text-gray-700">Fair, competitive cash offers</p>
        </div>
        <div class="flex items-center justify-center gap-4">
          <span class="text-2xl text-brand-sky">✓</span>
          <p class="text-gray-700">You choose the closing date</p>
        </div>
        <div class="flex items-center justify-center gap-4">
          <span class="text-2xl text-brand-sky">✓</span>
          <p class="text-gray-700">We handle all paperwork</p>
        </div>
      </div>

      <p class="text-lg font-bold text-brand-sky mb-8"><a href="tel:443-327-9292" class="hover:underline">Ready? Call 443-327-9292</a></p>
    </div>
  </section>

  <!-- VIDEO TESTIMONIALS SECTION -->
  <section class="py-24 bg-gray-50">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      <h2 class="text-4xl font-black text-center text-brand-purple mb-12">See It From Our Customers</h2>

      <div class="bg-white p-8 rounded-lg shadow-sm text-center">
        <div class="aspect-video bg-gray-200 rounded-lg mb-6 flex items-center justify-center">
          <div class="text-gray-500 text-center">
            <p class="text-2xl font-bold mb-2">🎥</p>
            <p class="text-lg font-semibold">Customer Testimonial Video</p>
            <p class="text-sm text-gray-400 mt-2">30-second video of happy customer sharing their experience</p>
          </div>
        </div>
        <p class="text-brand-sky font-bold"><a href="tel:443-327-9292" class="hover:underline">Want to share your story? Call 443-327-9292</a></p>
      </div>
    </div>
  </section>

  <!-- TESTIMONIALS SECTION -->
  <section class="py-24 bg-white">
    <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8">
      <h2 class="text-4xl font-black text-center text-brand-purple mb-12">What Our Customers Say</h2>

      <div class="space-y-8">
        <div>
          <p class="text-gray-700 italic mb-3">"The entire process was smooth and professional. I got my cash quickly. Highly recommend!"</p>
          <p class="font-bold text-brand-purple">Sarah Johnson • Baltimore, MD</p>
          <p class="text-sm text-brand-sky"><a href="tel:443-327-9292" class="hover:underline">Call 443-327-9292</a></p>
        </div>

        <div>
          <p class="text-gray-700 italic mb-3">"I inherited a property I didn't want. They bought it as-is with no hassles. Life changing!"</p>
          <p class="font-bold text-brand-purple">Michael Chen • Towson, MD</p>
          <p class="text-sm text-brand-sky"><a href="tel:443-327-9292" class="hover:underline">443-327-9292</a></p>
        </div>

        <div>
          <p class="text-gray-700 italic mb-3">"No pressure, no games, just a fair offer and quick closing. Best experience!"</p>
          <p class="font-bold text-brand-purple">Jennifer Williams • Columbia, MD</p>
          <p class="text-sm text-brand-sky"><a href="tel:443-327-9292" class="hover:underline">443-327-9292</a></p>
        </div>
      </div>
    </div>
  </section>

  <!-- FINAL CTA SECTION -->
  <section class="py-32 bg-brand-purple text-white text-center">
    <div class="max-w-2xl mx-auto px-4 sm:px-6 lg:px-8">
      <h2 class="text-5xl font-black mb-8">Ready to Sell?</h2>
      <p class="text-xl mb-12">Get your free cash offer in minutes. No obligation.</p>

      <div class="flex flex-col sm:flex-row gap-6 justify-center">
        <a href="#form" class="inline-block bg-brand-sky text-white px-12 py-4 rounded-lg font-bold text-lg hover:bg-brand-teal transition-all">
          Get Free Offer
        </a>
        <a href="tel:443-327-9292" class="inline-block bg-brand-sky text-white px-12 py-4 rounded-lg font-bold text-lg hover:bg-brand-teal transition-all">
          Call 443-327-9292
        </a>
      </div>

      <p class="text-lg font-bold text-brand-sky mt-12"><a href="tel:443-327-9292" class="hover:underline">📞 443-327-9292</a> • Always available</p>
    </div>
  </section>
</Layout>
