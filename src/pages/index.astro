---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Alberti Home Buyers LLC - Buy Houses Fast for Cash">
  <!-- Hero Section -->
  <section class="bg-gradient-to-r from-blue-600 to-blue-800 text-white py-20">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 md:grid-cols-2 gap-12 items-center">
        <div>
          <h1 class="text-5xl font-bold mb-6">Get a Cash Offer for Your House Today</h1>
          <p class="text-xl mb-8 text-blue-100">
            No commission. No fees. No waiting. We buy houses in any condition, any situation.
          </p>
          <div class="flex gap-4">
            <a href="#form" class="bg-white text-blue-600 px-8 py-3 rounded font-bold hover:bg-gray-100">
              Get Offer
            </a>
            <a href="tel:443-345-1300" class="border-2 border-white text-white px-8 py-3 rounded font-bold hover:bg-white hover:text-blue-600">
              Call Now
            </a>
          </div>
        </div>
        <div class="bg-white bg-opacity-10 p-8 rounded-lg">
          <h2 class="text-2xl font-bold mb-6">Quick Cash Offer</h2>
          <form id="form" class="space-y-4" action="https://formspree.io/f/xyzpqwab" method="POST">
            <input type="text" name="name" placeholder="Your Name" required class="w-full px-4 py-2 rounded text-gray-900" />
            <input type="email" name="email" placeholder="Your Email" required class="w-full px-4 py-2 rounded text-gray-900" />
            <input type="tel" name="phone" placeholder="Your Phone" required class="w-full px-4 py-2 rounded text-gray-900" />
            <input type="text" name="address" placeholder="Property Address" required class="w-full px-4 py-2 rounded text-gray-900" />
            <button type="submit" class="w-full bg-yellow-400 text-gray-900 font-bold py-2 rounded hover:bg-yellow-500">
              Get Free Offer
            </button>
          </form>
        </div>
      </div>
    </div>
  </section>

  <!-- Why Choose Us -->
  <section class="py-16 bg-gray-50">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <h2 class="text-4xl font-bold text-center mb-12">Why Choose Alberti Home Buyers?</h2>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
        <div class="bg-white p-8 rounded-lg shadow">
          <h3 class="text-xl font-bold mb-4">💰 Fair Cash Offers</h3>
          <p>We make competitive cash offers for your property. No pressure. No obligation.</p>
        </div>
        <div class="bg-white p-8 rounded-lg shadow">
          <h3 class="text-xl font-bold mb-4">⚡ Fast Closing</h3>
          <p>Close in as little as 7 days. You choose the timeline that works for you.</p>
        </div>
        <div class="bg-white p-8 rounded-lg shadow">
          <h3 class="text-xl font-bold mb-4">✨ No Fees or Commission</h3>
          <p>We buy as-is. You don't pay any commissions, fees, or closing costs.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- How It Works Preview -->
  <section class="py-16">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <h2 class="text-4xl font-bold mb-12">How It Works</h2>
      <div class="grid grid-cols-1 md:grid-cols-4 gap-8">
        <div class="text-center">
          <div class="text-4xl font-bold text-blue-600 mb-4">1</div>
          <h3 class="font-bold mb-2">Fill Out the Form</h3>
          <p class="text-gray-600">Tell us about your property</p>
        </div>
        <div class="text-center">
          <div class="text-4xl font-bold text-blue-600 mb-4">2</div>
          <h3 class="font-bold mb-2">Property Inspection</h3>
          <p class="text-gray-600">We visit and assess your home</p>
        </div>
        <div class="text-center">
          <div class="text-4xl font-bold text-blue-600 mb-4">3</div>
          <h3 class="font-bold mb-2">Get Cash Offer</h3>
          <p class="text-gray-600">Receive a fair, no-obligation offer</p>
        </div>
        <div class="text-center">
          <div class="text-4xl font-bold text-blue-600 mb-4">4</div>
          <h3 class="font-bold mb-2">Close Fast</h3>
          <p class="text-gray-600">Get paid and move forward</p>
        </div>
      </div>
      <div class="text-center mt-12">
        <a href="/how-it-works" class="text-blue-600 font-bold hover:underline">Learn More →</a>
      </div>
    </div>
  </section>

  <!-- CTA Section -->
  <section class="bg-blue-600 text-white py-16">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <h2 class="text-4xl font-bold mb-6">Ready to Sell Your House?</h2>
      <p class="text-xl mb-8">Get your free cash offer in minutes. No commitment required.</p>
      <a href="tel:555-555-5555" class="inline-block bg-yellow-400 text-blue-600 px-8 py-3 rounded font-bold hover:bg-yellow-500">
        Call 555-555-5555
      </a>
    </div>
  </section>
</Layout>
