---
type IconName =
  | 'lock'
  | 'clock'
  | 'pin'
  | 'document'
  | 'phone'
  | 'calendar'
  | 'dollar'
  | 'check';

interface Props {
  name: IconName;
  class?: string;
}

const { name, class: className = '' } = Astro.props;

const paths: Record<IconName, string> = {
  lock: '<rect x="5" y="11" width="14" height="9" rx="2" /><path d="M8 11V7a4 4 0 0 1 8 0v4" />',
  clock: '<circle cx="12" cy="12" r="9" /><path d="M12 7v5l3.5 2" />',
  pin: '<path d="M12 21s7-7.5 7-12a7 7 0 1 0-14 0c0 4.5 7 12 7 12z" /><circle cx="12" cy="9" r="2.5" />',
  document: '<path d="M7 3h7l4 4v13a1 1 0 0 1-1 1H7a1 1 0 0 1-1-1V4a1 1 0 0 1 1-1z" /><path d="M14 3v4h4" /><path d="M8.5 12.5h7M8.5 15.5h7M8.5 9.5h3" />',
  phone: '<path d="M6.6 10.8a15.5 15.5 0 0 0 6.6 6.6l2.2-2.2a1.2 1.2 0 0 1 1.2-.3 9.6 9.6 0 0 0 3 .5 1.2 1.2 0 0 1 1.2 1.2V20a1.2 1.2 0 0 1-1.2 1.2A16.8 16.8 0 0 1 3 4.2 1.2 1.2 0 0 1 4.2 3h3.4a1.2 1.2 0 0 1 1.2 1.2 9.6 9.6 0 0 0 .5 3 1.2 1.2 0 0 1-.3 1.2z" />',
  calendar: '<rect x="3" y="5" width="18" height="16" rx="2" /><path d="M3 10h18M8 3v4M16 3v4" />',
  dollar: '<circle cx="12" cy="12" r="9" /><path d="M12 7v10M9.5 9.5c0-1.4 1.2-2.5 2.7-2.5 1.4 0 2.6.9 2.6 2.1 0 3-5.3 1.6-5.3 4.6 0 1.3 1.2 2.3 2.7 2.3 1.5 0 2.7-1 2.7-2.3" />',
  check: '<path d="M5 13l4 4L19 7" />',
};
---

<svg
  xmlns="http://www.w3.org/2000/svg"
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="2"
  stroke-linecap="round"
  stroke-linejoin="round"
  width="1em"
  height="1em"
  class={`inline-block align-[-0.125em] ${className}`}
  aria-hidden="true"
  set:html={paths[name]}
/>
