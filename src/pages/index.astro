---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Alberti Home Buyers LLC - Buy Houses Fast for Cash">
  <!-- Hero Section -->
  <section class="bg-gradient-to-br from-brand-purple via-brand-purple-dark to-brand-purple-soft text-white py-24 relative overflow-hidden">
    <div class="absolute inset-0 opacity-10">
      <div class="absolute top-0 right-0 w-96 h-96 bg-brand-orange rounded-full mix-blend-multiply filter blur-3xl"></div>
      <div class="absolute bottom-0 left-0 w-96 h-96 bg-brand-teal rounded-full mix-blend-multiply filter blur-3xl"></div>
    </div>
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
      <div class="grid grid-cols-1 md:grid-cols-2 gap-12 items-center">
        <div>
          <a href="tel:443-327-9292" class="inline-block text-4xl md:text-5xl font-heading font-bold mb-6 tracking-wide text-white hover:text-brand-orange transition">Call 443-327-9292</a>
<h1 style="color:#ffffff" class="text-5xl font-bold mb-6 text-white">Get a Cash Offer for Your House Today</h1>
          <p class="text-xl mb-8 text-purple-100">
            No commission. No fees. No waiting. We buy houses in any condition, any situation.
          </p>
          <ul class="mb-8 space-y-2 text-purple-100 text-lg"><li>✔ Cash offer in 24 hours</li><li>✔ Close in as little as 7 days</li><li>✔ No repairs, no fees, no commissions</li></ul>      <div class="flex gap-4">
            <a href="#form" class="bg-brand-orange text-white px-8 py-3 rounded-full font-bold hover:bg-brand-orange-dark">
              Get Offer
            </a>
            <a href="tel:443-327-9292" class="border-2 border-white text-white px-8 py-3 rounded font-bold hover:bg-white hover:text-brand-purple">
              Call Now
            </a>
          </div>
        </div>
        <div class="bg-white p-8 rounded-2xl shadow-2xl">
          <h2 class="text-2xl font-bold mb-6">Quick Cash Offer</h2>
          <form id="form" class="space-y-4" action="https://formspree.io/f/xjybgbry" method="POST">
            <input type="text" name="name" placeholder="Your Name" required class="w-full px-4 py-3 rounded-lg border border-gray-300 text-gray-900 focus:outline-none focus:border-brand-purple focus:ring-2 focus:ring-brand-purple/30" />
            <input type="email" name="email" placeholder="Your Email" required class="w-full px-4 py-3 rounded-lg border border-gray-300 text-gray-900 focus:outline-none focus:border-brand-purple focus:ring-2 focus:ring-brand-purple/30" />
            <input type="tel" name="phone" placeholder="Your Phone" required class="w-full px-4 py-3 rounded-lg border border-gray-300 text-gray-900 focus:outline-none focus:border-brand-purple focus:ring-2 focus:ring-brand-purple/30" />
            <input type="text" name="address" placeholder="Property Address" required class="w-full px-4 py-3 rounded-lg border border-gray-300 text-gray-900 focus:outline-none focus:border-brand-purple focus:ring-2 focus:ring-brand-purple/30" />
            <button type="submit" class="w-full bg-brand-orange text-white font-bold py-2 rounded-full hover:bg-brand-orange-dark">
              Get Free Offer
            </button>
          </form>
          <div class="mt-4 text-center border-t pt-4">
            <p class="text-gray-600 text-sm">Or call us directly: <a href="tel:443-327-9292" class="text-brand-orange font-bold hover:underline">443-327-9292</a></p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Trust Bar --><section class="bg-gradient-to-r from-brand-purple to-brand-purple-dark text-white py-12 border-b-4 border-brand-orange"><div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 grid grid-cols-2 md:grid-cols-4 gap-8 text-center"><div class="transform hover:scale-110 transition-transform duration-300"><div class="text-5xl font-heading font-black">500+</div><div class="text-brand-orange text-sm font-bold tracking-wide mt-2 uppercase">Homes Purchased</div></div><div class="transform hover:scale-110 transition-transform duration-300"><div class="text-5xl font-heading font-black">7 Days</div><div class="text-brand-orange text-sm font-bold tracking-wide mt-2 uppercase">Average Closing</div></div><div class="transform hover:scale-110 transition-transform duration-300"><div class="text-5xl font-heading font-black">$0</div><div class="text-brand-orange text-sm font-bold tracking-wide mt-2 uppercase">Fees or Commissions</div></div><div class="transform hover:scale-110 transition-transform duration-300"><div class="text-5xl font-heading font-black">24 hrs</div><div class="text-brand-orange text-sm font-bold tracking-wide mt-2 uppercase">Offer Response</div></div></div></section>    <!-- RECENT ACTIVITY FEED -->
  <section class="py-16 bg-gradient-to-br from-white via-blue-50 to-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <h2 class="text-4xl font-bold text-center mb-2">Recent Sales Activity</h2>
      <div class="w-20 h-1 bg-gradient-to-r from-brand-orange via-brand-sky to-brand-teal mx-auto mb-8"></div>
      <p class="text-center text-gray-600 mb-12 text-lg">Homes being purchased right now across Maryland</p>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-6 max-w-2xl mx-auto">
        <div class="activity-item card border-l-4 border-brand-orange">
          <p class="text-sm text-brand-orange font-bold">✅ Just Now</p>
          <p class="font-bold mt-2">3-bed home in Baltimore</p>
          <p class="text-gray-600 text-sm">Offer accepted: <span class="text-brand-orange font-bold">$285,000</span></p>
          <p class="text-xs text-gray-500 mt-2">Closing in 10 days</p>
        </div>
        <div class="activity-item card border-l-4 border-brand-orange">
          <p class="text-sm text-brand-orange font-bold">✅ 2 hours ago</p>
          <p class="font-bold mt-2">2-bed condo in Towson</p>
          <p class="text-gray-600 text-sm">Offer accepted: <span class="text-brand-orange font-bold">$165,000</span></p>
          <p class="text-xs text-gray-500 mt-2">Closing in 7 days</p>
        </div>
        <div class="activity-item card border-l-4 border-brand-orange">
          <p class="text-sm text-brand-orange font-bold">✅ 5 hours ago</p>
          <p class="font-bold mt-2">4-bed house in Columbia</p>
          <p class="text-gray-600 text-sm">Offer accepted: <span class="text-brand-orange font-bold">$425,000</span></p>
          <p class="text-xs text-gray-500 mt-2">Closing in 14 days</p>
        </div>
        <div class="activity-item card border-l-4 border-brand-orange">
          <p class="text-sm text-brand-orange font-bold">✅ Yesterday</p>
          <p class="font-bold mt-2">Townhouse in Annapolis</p>
          <p class="text-gray-600 text-sm">Offer accepted: <span class="text-brand-orange font-bold">$245,000</span></p>
          <p class="text-xs text-gray-500 mt-2">Closing in 9 days</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Why Choose Us -->
  <section class="py-16 bg-gradient-to-br from-gray-50 via-blue-50 to-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <h2 class="text-4xl font-bold text-center mb-2">Why Choose Alberti Home Buyers?</h2>
      <div class="w-20 h-1 bg-gradient-to-r from-brand-orange via-brand-sky to-brand-teal mx-auto mb-8"></div>
      <p class="text-center font-bold mb-8"><span class="text-brand-orange">Call</span> <a href="tel:443-327-9292" class="text-brand-sky hover:underline">443-327-9292</a> <span class="text-brand-orange">to speak with a specialist today</span></p>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
        <div class="card">
          <h3 class="text-xl font-bold mb-4">💰 Fair Cash Offers</h3>
          <p>We make competitive cash offers for your property. No pressure. No obligation. <a href="tel:443-327-9292" class="text-brand-orange font-bold hover:underline">443-327-9292</a></p>
        </div>
        <div class="card">
          <h3 class="text-xl font-bold mb-4">⚡ Fast Closing</h3>
          <p>Close in as little as 7 days. You choose the timeline that works for you. Questions? <a href="tel:443-327-9292" class="text-brand-orange font-bold hover:underline">Call us</a></p>
        </div>
        <div class="card">
          <h3 class="text-xl font-bold mb-4">✨ No Fees or Commission</h3>
          <p>We buy as-is. You don't pay any commissions, fees, or closing costs. Contact us: <a href="tel:443-327-9292" class="text-brand-orange font-bold hover:underline">443-327-9292</a></p>
        </div>
      </div>
    </div>
  </section>

  <!-- ALBERTI vs TRADITIONAL COMPARISON -->
  <section class="py-16 bg-gradient-to-br from-brand-purple-tint via-blue-50 to-white">
    <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
      <h2 class="text-4xl font-bold text-center mb-2">Alberti vs Traditional Real Estate</h2>
      <div class="w-20 h-1 bg-gradient-to-r from-brand-orange via-brand-sky to-brand-teal mx-auto mb-8"></div>
      <p class="text-center text-gray-600 mb-12 text-lg">See why thousands choose us</p>

      <div class="overflow-x-auto">
        <table class="comparison-table w-full">
          <thead>
            <tr class="bg-gradient-to-r from-brand-purple to-brand-purple-dark text-white">
              <td class="font-black text-left text-lg p-4">Feature</td>
              <td class="text-center font-bold bg-gradient-to-b from-brand-sky to-brand-teal text-white py-4">Alberti Home Buyers</td>
              <td class="text-center font-bold">Traditional Real Estate</td>
            </tr>
          </thead>
          <tbody>
            <tr>
              <td>Closing Time</td>
              <td class="text-center"><span class="checkmark">✓</span> 7-14 days</td>
              <td class="text-center"><span class="cross">✗</span> 30-60 days</td>
            </tr>
            <tr>
              <td>Repairs Needed</td>
              <td class="text-center"><span class="checkmark">✓</span> None - buy as-is</td>
              <td class="text-center"><span class="cross">✗</span> Often required</td>
            </tr>
            <tr>
              <td>Commissions & Fees</td>
              <td class="text-center"><span class="checkmark">✓</span> $0</td>
              <td class="text-center"><span class="cross">✗</span> 6-10% total</td>
            </tr>
            <tr>
              <td>Showings & Inspections</td>
              <td class="text-center"><span class="checkmark">✓</span> One inspection</td>
              <td class="text-center"><span class="cross">✗</span> Multiple showings</td>
            </tr>
            <tr>
              <td>Certainty of Sale</td>
              <td class="text-center"><span class="checkmark">✓</span> 100% guaranteed</td>
              <td class="text-center"><span class="cross">✗</span> Financing contingent</td>
            </tr>
            <tr>
              <td>Financing Issues</td>
              <td class="text-center"><span class="checkmark">✓</span> We handle it</td>
              <td class="text-center"><span class="cross">✗</span> Your responsibility</td>
            </tr>
            <tr>
              <td>Cash in Pocket</td>
              <td class="text-center"><span class="checkmark">✓</span> Full offer amount</td>
              <td class="text-center"><span class="cross">✗</span> After all fees</td>
            </tr>
          </tbody>
        </table>
      </div>

      <div class="text-center mt-12">
        <a href="tel:443-327-9292" class="inline-block bg-brand-orange text-white px-12 py-4 rounded-full font-black text-xl hover:bg-brand-orange-dark transform hover:scale-105 transition-all shadow-lg">
          Get Your Free Comparison
        </a>
      </div>
    </div>
  </section>

  <!-- How It Works Preview -->
  <section class="py-16">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <h2 class="text-4xl font-bold text-center mb-12">How It Works</h2>
      <div class="grid grid-cols-1 md:grid-cols-4 gap-8">
        <div class="text-center">
          <div class="w-16 h-16 mx-auto mb-5 flex items-center justify-center rounded-full bg-brand-purple text-white text-2xl font-bold shadow-lg">1</div>
          <h3 class="font-bold mb-2">Fill Out the Form</h3>
          <p class="text-gray-600">Tell us about your property or call <a href="tel:443-327-9292" class="text-brand-orange font-bold hover:underline">443-327-9292</a></p>
        </div>
        <div class="text-center">
          <div class="w-16 h-16 mx-auto mb-5 flex items-center justify-center rounded-full bg-brand-purple text-white text-2xl font-bold shadow-lg">2</div>
          <h3 class="font-bold mb-2">Property Inspection</h3>
          <p class="text-gray-600">We visit and assess your home</p>
        </div>
        <div class="text-center">
          <div class="w-16 h-16 mx-auto mb-5 flex items-center justify-center rounded-full bg-brand-purple text-white text-2xl font-bold shadow-lg">3</div>
          <h3 class="font-bold mb-2">Get Cash Offer</h3>
          <p class="text-gray-600">Receive a fair, no-obligation offer</p>
        </div>
        <div class="text-center">
          <div class="w-16 h-16 mx-auto mb-5 flex items-center justify-center rounded-full bg-brand-purple text-white text-2xl font-bold shadow-lg">4</div>
          <h3 class="font-bold mb-2">Close Fast</h3>
          <p class="text-gray-600">Get paid and move forward</p>
        </div>
      </div>
      <div class="text-center mt-12">
        <a href="/how-it-works" class="text-brand-orange font-bold hover:underline">Learn More →</a>
      </div>
    </div>
  </section>

  <!-- Testimonials --><section class="py-20 bg-gradient-to-b from-gray-50 via-blue-50 to-white"><div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8"><h2 class="text-4xl font-bold text-center mb-2">What Homeowners Say</h2><div class="w-20 h-1 bg-gradient-to-r from-brand-orange via-brand-sky to-brand-teal mx-auto mb-8"></div><p class="text-center font-bold mb-12 text-lg"><span class="text-brand-sky">Join</span> <span class="text-brand-orange">hundreds of satisfied customers</span></p><div class="grid grid-cols-1 md:grid-cols-3 gap-8"><div class="card border-l-4 border-brand-orange"><div class="text-brand-orange text-2xl mb-4">★★★★★</div><p class="mb-6 text-lg leading-relaxed">"They made selling my house effortless. Fair cash offer and we closed in under two weeks with zero fees."</p><p class="font-bold text-brand-purple">— Homeowner, Maryland</p></div><div class="card border-l-4 border-brand-orange"><div class="text-brand-orange text-2xl mb-4">★★★★★</div><p class="mb-6 text-lg leading-relaxed">"I inherited a property that needed a lot of work. Alberti bought it as-is and handled everything professionally."</p><p class="font-bold text-brand-purple">— Homeowner, Maryland</p></div><div class="card border-l-4 border-brand-orange"><div class="text-brand-orange text-2xl mb-4">★★★★★</div><p class="mb-6 text-lg leading-relaxed">"No pressure, no hidden costs, and the team kept me informed the whole way. Highly recommend!"</p><p class="font-bold text-brand-purple">— Homeowner, Maryland</p></div></div></div></section>    <!-- CTA Section -->
  <section class="bg-gradient-to-r from-brand-purple via-brand-purple-dark to-brand-purple-soft text-white py-24 relative overflow-hidden">
    <div class="absolute inset-0 opacity-20">
      <div class="absolute top-0 left-1/4 w-80 h-80 bg-brand-orange rounded-full mix-blend-multiply filter blur-3xl animate-pulse"></div>
      <div class="absolute bottom-0 right-1/4 w-80 h-80 bg-brand-sky rounded-full mix-blend-multiply filter blur-3xl"></div>
    </div>
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center relative z-10">
      <h2 class="text-5xl font-bold mb-6">Ready to Sell Your House?</h2>
      <p class="text-2xl mb-12 text-brand-sky font-bold">Get your free cash offer in minutes. No commitment required.</p>
      <div class="flex flex-col sm:flex-row gap-4 justify-center">
        <a href="tel:443-327-9292" class="inline-block bg-brand-orange text-white px-12 py-4 rounded-full font-black text-2xl hover:bg-brand-orange-dark hover:shadow-2xl transform hover:scale-105 transition-all duration-300 shadow-xl">
          Call 443-327-9292
        </a>
        <a href="#form" class="inline-block bg-white text-brand-purple px-12 py-4 rounded-full font-bold text-lg hover:bg-brand-sky hover:text-white transform hover:scale-105 transition-all duration-300 shadow-xl">
          Get Free Offer
        </a>
      </div>
    </div>
  </section>
</Layout>
