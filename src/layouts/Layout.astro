---
import '../styles/global.css';

interface Props {
  title?: string; description?: string;
}

const { title = 'Sell Your House Fast for Cash | Alberti Home Buyers LLC', description = 'Alberti Home Buyers LLC buys houses fast for cash in any condition. No commissions, no fees, no repairs. Get a free, no-obligation cash offer in 24 hours.' } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="description" content={description} /><link rel="canonical" href="https://albertihomebuyersllc.com/" /><meta property="og:type" content="website" /><meta property="og:site_name" content="Alberti Home Buyers LLC" /><meta property="og:title" content={title} /><meta property="og:description" content={description} /><meta property="og:url" content="https://albertihomebuyersllc.com/" /><meta name="twitter:card" content="summary_large_image" /><meta name="twitter:title" content={title} /><meta name="twitter:description" content={description} />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" /><link rel="preconnect" href="https://fonts.gstatic.com" crossorigin /><link href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,400;0,600;0,700;1,600;1,700&family=Open+Sans:ital,wght@0,400;0,500;0,600;0,700;1,400;1,600;1,700&display=swap" rel="stylesheet" /><title>{title}</title>
  <script async src="https://p3.trustedtv.com/4df4279d-8c9b-4e67-a797-6d68613b60ca.js"></script>
  <script>
    function toggleChat() {
      const widget = document.getElementById('chatWidget');
      if (widget.style.display === 'none') {
        widget.style.display = 'flex';
      } else {
        widget.style.display = 'none';
      }
    }

    function initBeforeAfterSlider() {
      const sliders = document.querySelectorAll('.before-after-container');
      sliders.forEach(slider => {
        const imgSlider = slider.querySelector('.img-slider');
        const imgBefore = slider.querySelector('.img-before');
        let isActive = false;

        document.addEventListener('mousedown', () => {
          isActive = true;
        });
        document.addEventListener('mouseup', () => {
          isActive = false;
        });

        imgSlider.addEventListener('mousedown', () => {
          isActive = true;
        });

        slider.addEventListener('mousemove', (e) => {
          if (!isActive) return;
          let x = e.pageX - slider.getBoundingClientRect().left;
          if (x < 0) x = 0;
          if (x > slider.offsetWidth) x = slider.offsetWidth;
          imgBefore.style.width = x + 'px';
          imgSlider.style.left = x + 'px';
        });

        slider.addEventListener('touchstart', () => {
          isActive = true;
        });
        slider.addEventListener('touchend', () => {
          isActive = false;
        });
        slider.addEventListener('touchmove', (e) => {
          if (!isActive) return;
          let x = e.touches[0].pageX - slider.getBoundingClientRect().left;
          if (x < 0) x = 0;
          if (x > slider.offsetWidth) x = slider.offsetWidth;
          imgBefore.style.width = x + 'px';
          imgSlider.style.left = x + 'px';
        });
      });
    }

    document.addEventListener('DOMContentLoaded', initBeforeAfterSlider);
  </script>
  </head>
  <body class="bg-white text-gray-900">
    <!-- Header/Navigation -->
    <header class="sticky top-0 z-50 border-b border-gray-200 bg-white/95 backdrop-blur-sm shadow-lg">
      <nav class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-3 flex justify-between items-center">
        <div class="flex items-center gap-4">
          <a href="/" class="w-24 h-24 flex-shrink-0">
            <img src="/logo.png" alt="Alberti Home Buyers" class="w-full h-full object-contain" />
          </a>
          <a href="/" class="text-2xl font-bold text-brand-purple hidden sm:inline">Alberti Home Buyers</a>
        </div>
        <ul class="hidden md:flex gap-8">
          <li><a href="/calculator" class="hover:text-brand-orange font-bold">Calculator</a></li>
          <li><a href="/how-it-works" class="hover:text-brand-orange">How It Works</a></li>
          <li><a href="/about" class="hover:text-brand-orange">About</a></li>
          <li><a href="/faq" class="hover:text-brand-orange">FAQ</a></li>
          <li><a href="/contact" class="hover:text-brand-orange">Contact</a></li>
        </ul>
        <a href="tel:443-327-9292" class="bg-brand-orange text-white px-8 py-4 rounded-full font-black hover:bg-brand-orange-dark text-3xl shadow-lg hover:shadow-2xl transition-all">
          443-327-9292
        </a>
      </nav>
    </header>

    <!-- Main Content -->
    <main class="min-h-screen">
      <slot />
    </main>

    <!-- FLOATING ACTION BAR -->
    <div class="floating-action-bar">
      <a href="tel:443-327-9292" class="floating-btn call" title="Call Us">
        ☎️
      </a>
      <a href="https://wa.me/14433279292" target="_blank" rel="noopener noreferrer" class="floating-btn whatsapp" title="WhatsApp">
        💬
      </a>
      <button class="floating-btn chat" onclick="toggleChat()" title="Live Chat">
        💭
      </button>
    </div>

    <!-- LIVE CHAT WIDGET -->
    <div id="chatWidget" class="fixed bottom-32 right-8 bg-white rounded-lg shadow-2xl hidden z-40 w-80 h-96 flex flex-col" style="display: none;">
      <div class="bg-brand-orange text-white p-4 rounded-t-lg flex justify-between items-center">
        <div>
          <h3 class="font-bold">Live Chat</h3>
          <p class="text-sm opacity-90">We typically reply in minutes</p>
        </div>
        <button onclick="toggleChat()" class="text-white font-bold text-xl">×</button>
      </div>
      <div class="flex-1 overflow-y-auto p-4 bg-gray-50">
        <div class="bg-blue-100 p-3 rounded-lg mb-3 rounded-br-none">
          <p class="text-sm">Hi! 👋 How can we help you today?</p>
          <p class="text-xs opacity-70 mt-1">2:30 PM</p>
        </div>
      </div>
      <div class="border-t p-3 bg-white rounded-b-lg">
        <input type="text" placeholder="Type a message..." class="w-full border rounded-lg px-3 py-2 text-sm focus:outline-none focus:border-brand-orange">
      </div>
    </div>

    <!-- Footer -->
    <footer class="bg-gray-900 text-white mt-16">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
        <div class="grid grid-cols-1 md:grid-cols-3 gap-8 mb-8">
          <div>
            <div class="flex items-center gap-4 mb-4">
              <img src="/logo.png" alt="Alberti Home Buyers" class="w-20 h-20 object-contain" />
              <h3 class="text-2xl font-bold">Alberti Home Buyers</h3>
            </div>
            <p class="text-gray-400">We buy houses fast for cash. No commission. No fees. No hassle.</p>
          </div>
          <div>
            <h4 class="font-bold mb-4">Quick Links</h4>
            <ul class="space-y-2 text-gray-400">
              <li><a href="/how-it-works" class="hover:text-white">How It Works</a></li>
              <li><a href="/about" class="hover:text-white">About Us</a></li>
              <li><a href="/faq" class="hover:text-white">FAQ</a></li>
            </ul>
          </div>
          <div>
            <h4 class="font-bold mb-4">Contact</h4>
            <p class="text-gray-400 mb-2">
              <a href="tel:443-327-9292" class="hover:text-white">443-327-9292</a>
            </p>
            <p class="text-gray-400">
              <a href="mailto:info@albertihomebuyersllc.com" class="hover:text-white">info@albertihomebuyersllc.com</a>
            </p>
          </div>
        </div>
        <div class="border-t border-gray-800 pt-8 flex justify-between items-center">
          <p class="text-gray-400">&copy; 2024 Alberti Home Buyers LLC. All rights reserved.</p>
          <div class="flex gap-4">
            <a href="/privacy" class="text-gray-400 hover:text-white">Privacy</a>
            <a href="/terms" class="text-gray-400 hover:text-white">Terms</a>
          </div>
        </div>
      </div>
    </footer>
  </body>
</html>
