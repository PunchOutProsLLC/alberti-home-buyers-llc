---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Home Value Calculator - Alberti Home Buyers LLC">
  <section class="py-20 bg-gradient-to-br from-brand-purple via-brand-purple-dark to-brand-purple-soft text-white min-h-screen flex items-center">
    <div class="max-w-2xl mx-auto px-4 sm:px-6 lg:px-8 w-full">
      <h1 class="text-5xl font-bold text-center mb-4">Home Value Calculator</h1>
      <p class="text-center text-brand-sky text-xl mb-4">Get an instant estimate of your home's cash value</p>
      <p class="text-center text-white text-lg mb-12">Or call <a href="tel:443-327-9292" class="text-brand-sky font-bold hover:underline">443-327-9292</a> for a personalized quote</p>

      <div class="bg-white text-gray-900 p-8 rounded-2xl shadow-2xl">
        <form id="calculatorForm" class="space-y-6">
          <!-- Property Type -->
          <div>
            <label class="block font-bold mb-3 text-lg">1. Property Type</label>
            <div class="grid grid-cols-2 gap-3">
              <label class="flex items-center p-3 border-2 border-gray-300 rounded-lg cursor-pointer hover:border-brand-orange hover:bg-brand-purple-tint transition">
                <input type="radio" name="propertyType" value="single" checked class="w-4 h-4">
                <span class="ml-3 font-semibold">Single Family</span>
              </label>
              <label class="flex items-center p-3 border-2 border-gray-300 rounded-lg cursor-pointer hover:border-brand-orange hover:bg-brand-purple-tint transition">
                <input type="radio" name="propertyType" value="condo" class="w-4 h-4">
                <span class="ml-3 font-semibold">Condo</span>
              </label>
              <label class="flex items-center p-3 border-2 border-gray-300 rounded-lg cursor-pointer hover:border-brand-orange hover:bg-brand-purple-tint transition">
                <input type="radio" name="propertyType" value="townhouse" class="w-4 h-4">
                <span class="ml-3 font-semibold">Townhouse</span>
              </label>
              <label class="flex items-center p-3 border-2 border-gray-300 rounded-lg cursor-pointer hover:border-brand-orange hover:bg-brand-purple-tint transition">
                <input type="radio" name="propertyType" value="multi" class="w-4 h-4">
                <span class="ml-3 font-semibold">Multi-Unit</span>
              </label>
            </div>
          </div>

          <!-- Square Footage -->
          <div>
            <label class="block font-bold mb-2">2. Approximate Square Footage</label>
            <input type="number" id="sqft" name="sqft" placeholder="e.g., 2000" class="calculator-input" min="500" max="10000">
          </div>

          <!-- Bedrooms -->
          <div>
            <label class="block font-bold mb-2">3. Number of Bedrooms</label>
            <select id="bedrooms" name="bedrooms" class="calculator-input">
              <option value="">Select...</option>
              <option value="1">1 Bedroom</option>
              <option value="2">2 Bedrooms</option>
              <option value="3">3 Bedrooms</option>
              <option value="4">4 Bedrooms</option>
              <option value="5">5+ Bedrooms</option>
            </select>
          </div>

          <!-- Property Condition -->
          <div>
            <label class="block font-bold mb-3">4. Property Condition</label>
            <div class="space-y-2">
              <label class="flex items-center p-3 border-2 border-gray-300 rounded-lg cursor-pointer hover:border-brand-orange hover:bg-brand-purple-tint transition">
                <input type="radio" name="condition" value="excellent" class="w-4 h-4">
                <span class="ml-3">Excellent (move-in ready)</span>
              </label>
              <label class="flex items-center p-3 border-2 border-gray-300 rounded-lg cursor-pointer hover:border-brand-orange hover:bg-brand-purple-tint transition">
                <input type="radio" name="condition" value="good" class="w-4 h-4">
                <span class="ml-3">Good (minor repairs needed)</span>
              </label>
              <label class="flex items-center p-3 border-2 border-gray-300 rounded-lg cursor-pointer hover:border-brand-orange hover:bg-brand-purple-tint transition">
                <input type="radio" name="condition" value="fair" checked class="w-4 h-4">
                <span class="ml-3">Fair (moderate repairs needed)</span>
              </label>
              <label class="flex items-center p-3 border-2 border-gray-300 rounded-lg cursor-pointer hover:border-brand-orange hover:bg-brand-purple-tint transition">
                <input type="radio" name="condition" value="poor" class="w-4 h-4">
                <span class="ml-3">Poor (major repairs needed)</span>
              </label>
            </div>
          </div>

          <!-- Mortgage Status -->
          <div>
            <label class="block font-bold mb-3">5. Do you have a mortgage?</label>
            <div class="space-y-2">
              <label class="flex items-center p-3 border-2 border-gray-300 rounded-lg cursor-pointer hover:border-brand-orange hover:bg-brand-purple-tint transition">
                <input type="radio" name="mortgage" value="no" checked class="w-4 h-4">
                <span class="ml-3">No mortgage</span>
              </label>
              <label class="flex items-center p-3 border-2 border-gray-300 rounded-lg cursor-pointer hover:border-brand-orange hover:bg-brand-purple-tint transition">
                <input type="radio" name="mortgage" value="yes" class="w-4 h-4">
                <span class="ml-3">Yes, I have a mortgage</span>
              </label>
            </div>
          </div>

          <button type="button" onclick="calculateValue()" class="w-full bg-brand-orange text-white font-black py-4 rounded-full text-lg hover:bg-brand-orange-dark transform hover:scale-105 transition-all shadow-lg">
            Get Your Estimate
          </button>
        </form>

        <!-- RESULT -->
        <div id="result" class="hidden mt-8">
          <div class="calculator-result">
            <div class="label">Your Estimated Home Value</div>
            <div id="estimatedValue" class="text-5xl font-black text-brand-orange">$0</div>
            <p class="text-sm opacity-90 mt-4">This is a preliminary estimate based on the information provided. Actual offer may vary.</p>
          </div>

          <div class="mt-8 p-6 bg-gradient-to-r from-brand-purple-tint to-white rounded-lg">
            <h3 class="font-bold text-brand-purple mb-4">What's Next?</h3>
            <ul class="space-y-2 text-gray-700">
              <li>✓ We'll contact you within 24 hours with a formal offer</li>
              <li>✓ No obligation - you can accept or decline</li>
              <li>✓ We handle all paperwork and closing costs</li>
              <li>✓ Get paid in as little as 7 days</li>
            </ul>
          </div>

          <form action="https://formspree.io/f/xjybgbry" method="POST" class="mt-8 space-y-4">
            <input type="hidden" id="estimateValue" name="estimateValue">
            <input type="text" name="name" placeholder="Your Name" required class="calculator-input">
            <input type="email" name="email" placeholder="Your Email" required class="calculator-input">
            <input type="tel" name="phone" placeholder="Your Phone" required class="calculator-input">
            <input type="text" name="address" placeholder="Property Address" required class="calculator-input">
            <button type="submit" class="w-full bg-brand-orange text-white font-black py-3 rounded-full hover:bg-brand-orange-dark transform hover:scale-105 transition-all shadow-lg">
              Confirm & Get Offer
            </button>
          </form>
        </div>
      </div>
    </div>
  </section>

  <script>
    function calculateValue() {
      const sqft = parseInt(document.getElementById('sqft').value) || 1500;
      const condition = document.querySelector('input[name="condition"]:checked').value;
      const propertyType = document.querySelector('input[name="propertyType"]:checked').value;

      // Base price per sqft in Maryland (conservative estimate)
      let pricePerSqft = 120;

      // Adjust based on property type
      if (propertyType === 'condo') pricePerSqft = 110;
      if (propertyType === 'multi') pricePerSqft = 100;

      // Calculate base value
      let baseValue = sqft * pricePerSqft;

      // Adjust based on condition
      const conditionMultipliers = {
        excellent: 1.1,
        good: 1.0,
        fair: 0.85,
        poor: 0.7
      };

      const estimatedValue = Math.round(baseValue * conditionMultipliers[condition]);

      // Display result
      document.getElementById('result').classList.remove('hidden');
      document.getElementById('estimatedValue').textContent = '$' + estimatedValue.toLocaleString();
      document.getElementById('estimateValue').value = '$' + estimatedValue.toLocaleString();

      // Scroll to result
      document.getElementById('result').scrollIntoView({ behavior: 'smooth' });
    }

    document.getElementById('calculatorForm').addEventListener('keypress', (e) => {
      if (e.key === 'Enter') {
        e.preventDefault();
        calculateValue();
      }
    });
  </script>
</Layout>
