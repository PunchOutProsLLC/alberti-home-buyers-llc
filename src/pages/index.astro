---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Sell My House Fast Baltimore | Alberti Home Buyers">
  <!-- HERO SECTION -->
  <section class="bg-gradient-to-br from-brand-purple via-brand-purple-dark to-brand-purple-soft text-white py-24 relative overflow-hidden">
    <div class="absolute inset-0 opacity-10">
      <div class="absolute top-0 right-0 w-96 h-96 bg-brand-orange rounded-full mix-blend-multiply filter blur-3xl"></div>
      <div class="absolute bottom-0 left-0 w-96 h-96 bg-brand-teal rounded-full mix-blend-multiply filter blur-3xl"></div>
    </div>
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 items-center">
        <div>
          <h1 class="text-6xl font-black mb-6 leading-tight text-white">Sell My House Fast In Baltimore</h1>
          <p class="text-2xl font-bold mb-6 text-brand-sky">You'll Get A Fair Offer • You Choose The Closing Date • We Pay All Costs!</p>
          <p class="text-lg mb-8 text-gray-100 leading-relaxed">
            No agent fees. No repairs needed. No waiting months. Get a fair all-cash offer in 24 hours and close in as little as 7 days.
          </p>
          <div class="flex flex-col sm:flex-row gap-4">
            <a href="#form" class="inline-block bg-gradient-to-r from-brand-sky to-brand-teal text-white px-12 py-4 rounded-full font-black text-xl hover:shadow-2xl transform hover:scale-105 transition-all shadow-xl">
              Get Free Offer
            </a>
            <a href="tel:443-327-9292" class="inline-block bg-brand-sky text-white px-12 py-4 rounded-full font-black text-xl hover:bg-brand-teal transform hover:scale-105 transition-all shadow-xl">
              Call 443-327-9292
            </a>
          </div>
        </div>
        <div class="bg-white/95 backdrop-blur p-10 rounded-2xl shadow-2xl">
          <h2 class="text-3xl font-black text-brand-purple mb-6">Get Your Free Cash Offer</h2>
          <form id="form" class="space-y-4" action="https://formspree.io/f/xjybgbry" method="POST">
            <input type="text" name="name" placeholder="Your Name" required class="w-full px-4 py-3 rounded-lg border-2 border-gray-300 text-gray-900 focus:outline-none focus:border-brand-sky focus:ring-2 focus:ring-brand-orange/30" />
            <input type="email" name="email" placeholder="Your Email" required class="w-full px-4 py-3 rounded-lg border-2 border-gray-300 text-gray-900 focus:outline-none focus:border-brand-sky focus:ring-2 focus:ring-brand-orange/30" />
            <input type="tel" name="phone" placeholder="Your Phone" required class="w-full px-4 py-3 rounded-lg border-2 border-gray-300 text-gray-900 focus:outline-none focus:border-brand-sky focus:ring-2 focus:ring-brand-orange/30" />
            <input type="text" name="address" placeholder="Property Address" required class="w-full px-4 py-3 rounded-lg border-2 border-gray-300 text-gray-900 focus:outline-none focus:border-brand-sky focus:ring-2 focus:ring-brand-orange/30" />
            <button type="submit" class="w-full bg-gradient-to-r from-brand-sky to-brand-teal text-white font-black py-3 rounded-full hover:shadow-lg transform hover:scale-102 transition-all">
              Get Your Offer Now
            </button>
          </form>
        </div>
      </div>
    </div>
  </section>

  <!-- TRUST SECTION -->
  <section class="py-16 bg-white">
    <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-12">
        <h2 class="text-4xl font-black text-brand-purple mb-4">Maryland's Most Trusted House Buyer</h2>
        <p class="text-lg text-gray-600 leading-relaxed max-w-3xl mx-auto mb-4">
          Alberti Home Buyers is Maryland's premier house-buying company. We pride ourselves on dealing with everyone honestly and openly. With years of experience in the Baltimore market, we've built a reputation for reliability and trust that you can count on.
        </p>
        <p class="text-lg font-bold text-brand-sky"><a href="tel:443-327-9292" class="hover:underline">📞 Call 443-327-9292</a> - Trusted by hundreds of Baltimore homeowners</p>
      </div>
    </div>
  </section>

  <!-- 3-STEP PROCESS -->
  <section class="py-20 bg-gray-50">
    <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-16">
        <h2 class="text-4xl font-black text-brand-purple mb-2">Sell Your Home Fast, Easy, and Hassle-Free</h2>
        <p class="text-lg text-gray-600">Our simple 3-step process gets you cash in hand quickly</p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-8 mb-12">
        <div class="card">
          <div class="flex items-center justify-center w-16 h-16 rounded-full bg-gradient-to-br from-brand-sky to-brand-teal text-white font-black text-2xl mb-6 mx-auto">1</div>
          <h3 class="text-2xl font-black text-center mb-4">Get a Fair Offer Within 24 Hours</h3>
          <p class="text-gray-600 text-center leading-relaxed">
            Fill out our simple form or <a href="tel:443-327-9292" class="text-brand-sky font-bold hover:underline">call 443-327-9292</a>. We'll evaluate your property and present you with a fair, all-cash offer with no obligation or hidden fees.
          </p>
        </div>

        <div class="card">
          <div class="flex items-center justify-center w-16 h-16 rounded-full bg-gradient-to-br from-brand-sky to-brand-teal text-white font-black text-2xl mb-6 mx-auto">2</div>
          <h3 class="text-2xl font-black text-center mb-4">Pick Your Closing Date</h3>
          <p class="text-gray-600 text-center leading-relaxed">
            You're in control. Choose the closing date that works best for you. We're flexible and can close in as little as 7 days if you need us to. <a href="tel:443-327-9292" class="text-brand-sky font-bold hover:underline">443-327-9292</a>
          </p>
        </div>

        <div class="card">
          <div class="flex items-center justify-center w-16 h-16 rounded-full bg-gradient-to-br from-brand-teal to-brand-sky text-white font-black text-2xl mb-6 mx-auto">3</div>
          <h3 class="text-2xl font-black text-center mb-4">Sell on Your Terms, Close Quickly</h3>
          <p class="text-gray-600 text-center leading-relaxed">
            No repairs, no inspections, no hassles. We pay all closing costs and you walk away with your cash. <a href="tel:443-327-9292" class="text-brand-sky font-bold hover:underline">Call us at 443-327-9292</a> to get started!
          </p>
        </div>
      </div>

      <div class="text-center">
        <a href="#form" class="inline-block bg-gradient-to-r from-brand-sky to-brand-teal text-white px-12 py-4 rounded-full font-black text-xl hover:shadow-2xl transform hover:scale-105 transition-all shadow-xl">
          Get Your Free Offer
        </a>
      </div>
    </div>
  </section>

  <!-- SITUATIONS SECTION -->
  <section class="py-20 bg-white border-t border-gray-100">
    <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-16">
        <h2 class="text-4xl font-black text-brand-purple mb-2">We Can Buy Your House No Matter Your Situation</h2>
        <p class="text-lg text-gray-600 mb-4">If you answer "yes" to any of these, we can help:</p>
        <p class="text-lg font-bold text-brand-sky"><a href="tel:443-327-9292" class="hover:underline">📞 443-327-9292</a> - Call now to discuss your situation</p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-6 mb-12">
        <div class="flex items-center p-4 bg-gradient-to-r from-brand-purple-tint to-blue-50 rounded-lg border-l-4 border-brand-sky">
          <span class="text-3xl font-black text-brand-sky mr-4">✓</span>
          <p class="font-bold text-gray-700">Going through foreclosure?</p>
        </div>
        <div class="flex items-center p-4 bg-gradient-to-r from-brand-purple-tint to-blue-50 rounded-lg border-l-4 border-brand-sky">
          <span class="text-3xl font-black text-brand-sky mr-4">✓</span>
          <p class="font-bold text-gray-700">Inherited an unwanted property?</p>
        </div>
        <div class="flex items-center p-4 bg-gradient-to-r from-brand-purple-tint to-blue-50 rounded-lg border-l-4 border-brand-sky">
          <span class="text-3xl font-black text-brand-sky mr-4">✓</span>
          <p class="font-bold text-gray-700">Own a fixer-upper you don't want to fix?</p>
        </div>
        <div class="flex items-center p-4 bg-gradient-to-r from-brand-purple-tint to-blue-50 rounded-lg border-l-4 border-brand-sky">
          <span class="text-3xl font-black text-brand-sky mr-4">✓</span>
          <p class="font-bold text-gray-700">Need to relocate quickly?</p>
        </div>
        <div class="flex items-center p-4 bg-gradient-to-r from-brand-purple-tint to-blue-50 rounded-lg border-l-4 border-brand-sky">
          <span class="text-3xl font-black text-brand-sky mr-4">✓</span>
          <p class="font-bold text-gray-700">Going through a divorce?</p>
        </div>
        <div class="flex items-center p-4 bg-gradient-to-r from-brand-purple-tint to-blue-50 rounded-lg border-l-4 border-brand-sky">
          <span class="text-3xl font-black text-brand-sky mr-4">✓</span>
          <p class="font-bold text-gray-700">Dealing with tenant problems?</p>
        </div>
      </div>

      <div class="text-center">
        <a href="tel:443-327-9292" class="inline-block bg-gradient-to-r from-brand-sky to-brand-teal text-white px-12 py-4 rounded-full font-black text-xl hover:shadow-2xl transform hover:scale-105 transition-all shadow-xl">
          Call 443-327-9292 - Let's Talk
        </a>
      </div>
    </div>
  </section>

  <!-- COMPARISON SECTION -->
  <section class="py-20 bg-gray-50">
    <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-16">
        <h2 class="text-4xl font-black text-brand-purple mb-2">Why Wait Months? Sell to Alberti Today</h2>
        <p class="text-lg font-bold text-brand-sky mt-4"><a href="tel:443-327-9292" class="hover:underline">📞 Call 443-327-9292</a> for your free comparison!</p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-8 mb-12">
        <!-- OUR WAY -->
        <div class="card border-l-4 border-brand-sky bg-white">
          <h3 class="text-2xl font-black text-brand-sky mb-6 text-center">Selling to Alberti Home Buyers</h3>
          <ul class="space-y-3">
            <li class="flex items-center text-gray-700">
              <span class="text-2xl text-brand-sky font-black mr-3">✓</span>
              <span class="font-bold">Fair cash offer in 24 hours</span>
            </li>
            <li class="flex items-center text-gray-700">
              <span class="text-2xl text-brand-sky font-black mr-3">✓</span>
              <span class="font-bold">Close in 7-14 days</span>
            </li>
            <li class="flex items-center text-gray-700">
              <span class="text-2xl text-brand-sky font-black mr-3">✓</span>
              <span class="font-bold">We pay ALL closing costs</span>
            </li>
            <li class="flex items-center text-gray-700">
              <span class="text-2xl text-brand-sky font-black mr-3">✓</span>
              <span class="font-bold">Zero fees • Zero commissions</span>
            </li>
            <li class="flex items-center text-gray-700">
              <span class="text-2xl text-brand-sky font-black mr-3">✓</span>
              <span class="font-bold">Buy as-is, no repairs needed</span>
            </li>
            <li class="flex items-center text-gray-700">
              <span class="text-2xl text-brand-sky font-black mr-3">✓</span>
              <span class="font-bold">No showings or inspections</span>
            </li>
            <li class="flex items-center text-gray-700">
              <span class="text-2xl text-brand-sky font-black mr-3">✓</span>
              <span class="font-bold">100% guaranteed sale</span>
            </li>
          </ul>
        </div>

        <!-- TRADITIONAL WAY -->
        <div class="card bg-gray-50">
          <h3 class="text-2xl font-black text-gray-600 mb-6 text-center">Listing With a Real Estate Agent</h3>
          <ul class="space-y-3">
            <li class="flex items-center text-gray-600">
              <span class="text-2xl text-gray-400 font-black mr-3">✗</span>
              <span class="font-bold">Takes 45-90+ days to sell</span>
            </li>
            <li class="flex items-center text-gray-600">
              <span class="text-2xl text-gray-400 font-black mr-3">✗</span>
              <span class="font-bold">No guaranteed buyer</span>
            </li>
            <li class="flex items-center text-gray-600">
              <span class="text-2xl text-gray-400 font-black mr-3">✗</span>
              <span class="font-bold">Closing costs often paid by you</span>
            </li>
            <li class="flex items-center text-gray-600">
              <span class="text-2xl text-gray-400 font-black mr-3">✗</span>
              <span class="font-bold">6-10% in commissions & fees</span>
            </li>
            <li class="flex items-center text-gray-600">
              <span class="text-2xl text-gray-400 font-black mr-3">✗</span>
              <span class="font-bold">Must make repairs to show</span>
            </li>
            <li class="flex items-center text-gray-600">
              <span class="text-2xl text-gray-400 font-black mr-3">✗</span>
              <span class="font-bold">Multiple showings & inspections</span>
            </li>
            <li class="flex items-center text-gray-600">
              <span class="text-2xl text-gray-400 font-black mr-3">✗</span>
              <span class="font-bold">Financing can fall through</span>
            </li>
          </ul>
        </div>
      </div>

      <div class="text-center">
        <a href="#form" class="inline-block bg-gradient-to-r from-brand-sky to-brand-teal text-white px-12 py-4 rounded-full font-black text-xl hover:shadow-2xl transform hover:scale-105 transition-all shadow-xl">
          Get Your Fair Cash Offer
        </a>
      </div>
    </div>
  </section>

  <!-- TESTIMONIALS -->
  <section class="py-20 bg-white border-t border-gray-100">
    <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-16">
        <h2 class="text-4xl font-black text-brand-purple mb-2">What Baltimore Sellers Are Saying</h2>
        <p class="text-lg text-gray-600 mb-4">Real feedback from homeowners who sold their house fast for cash</p>
        <p class="text-lg font-bold text-brand-sky"><a href="tel:443-327-9292" class="hover:underline">📞 443-327-9292</a> - Join hundreds of satisfied sellers!</p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
        <div class="card">
          <p class="text-brand-sky font-black text-lg mb-3">★★★★★</p>
          <p class="text-gray-700 mb-4 leading-relaxed italic">"The entire process was smooth and professional. They made everything easy and I got my cash quickly. Highly recommend! Call <a href="tel:443-327-9292" class="text-brand-sky font-bold hover:underline">443-327-9292</a>!"</p>
          <p class="font-bold text-brand-purple">Sarah Johnson</p>
          <p class="text-sm text-gray-500">Baltimore, MD • 2 weeks ago</p>
        </div>

        <div class="card">
          <p class="text-brand-sky font-black text-lg mb-3">★★★★★</p>
          <p class="text-gray-700 mb-4 leading-relaxed italic">"I inherited a property I didn't want. Alberti bought it as-is with no hassles. They truly made my life easier! <a href="tel:443-327-9292" class="text-brand-sky font-bold hover:underline">443-327-9292</a>"</p>
          <p class="font-bold text-brand-purple">Michael Chen</p>
          <p class="text-sm text-gray-500">Towson, MD • 1 month ago</p>
        </div>

        <div class="card">
          <p class="text-brand-sky font-black text-lg mb-3">★★★★★</p>
          <p class="text-gray-700 mb-4 leading-relaxed italic">"No pressure, no games, just a fair offer and quick closing. Best experience I could have asked for! <a href="tel:443-327-9292" class="text-brand-sky font-bold hover:underline">443-327-9292</a>"</p>
          <p class="font-bold text-brand-purple">Jennifer Williams</p>
          <p class="text-sm text-gray-500">Columbia, MD • 3 weeks ago</p>
        </div>
      </div>
    </div>
  </section>

  <!-- FINAL CTA -->
  <section class="py-20 bg-gradient-to-r from-brand-purple via-brand-purple-dark to-brand-purple-soft text-white relative overflow-hidden">
    <div class="absolute inset-0 opacity-10">
      <div class="absolute top-0 left-1/4 w-80 h-80 bg-brand-orange rounded-full mix-blend-multiply filter blur-3xl animate-pulse"></div>
      <div class="absolute bottom-0 right-1/4 w-80 h-80 bg-brand-sky rounded-full mix-blend-multiply filter blur-3xl"></div>
    </div>
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center relative z-10">
      <h2 class="text-5xl font-black mb-6">Ready to Sell Your House?</h2>
      <p class="text-2xl font-bold mb-12 text-brand-sky">Get your free cash offer in minutes. No commitment required.</p>
      <div class="flex flex-col sm:flex-row gap-4 justify-center">
        <a href="#form" class="inline-block bg-gradient-to-r from-brand-sky to-brand-teal text-white px-12 py-4 rounded-full font-black text-xl hover:shadow-2xl transform hover:scale-105 transition-all shadow-xl">
          Get Free Offer
        </a>
        <a href="tel:443-327-9292" class="inline-block bg-white text-brand-purple px-12 py-4 rounded-full font-black text-xl hover:bg-brand-sky hover:text-white transform hover:scale-105 transition-all shadow-xl">
          Call 443-327-9292
        </a>
      </div>
    </div>
  </section>
</Layout>
