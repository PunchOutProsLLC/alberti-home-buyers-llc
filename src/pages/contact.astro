---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Contact Us - Alberti Home Buyers LLC">
  <!-- PAGE HERO -->
  <section class="py-24 bg-brand-purple text-white">
    <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <h1 class="text-5xl font-black mb-6">Get in Touch</h1>
      <p class="text-2xl leading-relaxed">Call <a href="tel:443-327-9292" class="hover:underline">443-327-9292</a> to speak with our team immediately, or send us a message below.</p>
    </div>
  </section>

  <!-- TRUST BAR -->
  <section class="py-6 bg-brand-cream-soft border-y border-black/5">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 flex flex-wrap items-center justify-center gap-x-10 gap-y-3 text-sm font-semibold text-brand-purple">
      <span class="flex items-center gap-2"><span class="text-brand-orange">&#128274;</span> Licensed &amp; Insured</span>
      <span class="flex items-center gap-2"><span class="text-brand-orange">&#9201;</span> 24-Hour Cash Offers</span>
      <span class="flex items-center gap-2"><span class="text-brand-orange">&#128205;</span> Serving All of Maryland</span>
      <span class="flex items-center gap-2"><span class="text-brand-orange">&#128196;</span> No Fees, No Commissions</span>
    </div>
  </section>

  <section class="py-16 bg-gray-50">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 md:grid-cols-2 gap-12">
        <div>
          <h2 class="text-2xl font-bold mb-6">Contact Information</h2>

          <div class="mb-8">
            <h3 class="font-bold mb-2">Phone</h3>
            <a href="tel:443-327-9292" class="text-brand-orange hover:underline text-lg">
              443-327-9292
            </a>
            <p class="text-gray-600 text-sm mt-1">Available 24/7</p>
          </div>

          <div class="mb-8">
            <h3 class="font-bold mb-2">Email</h3>
            <a href="mailto:info@albertihomebuyersllc.com" class="text-brand-orange hover:underline">
              info@albertihomebuyersllc.com
            </a>
          </div>

          <div>
            <h3 class="font-bold mb-4">Follow Us</h3>
            <div class="flex gap-4">
              <a href="#" class="text-brand-purple hover:text-brand-orange">Facebook</a>
              <a href="#" class="text-brand-purple hover:text-brand-orange">Instagram</a>
              <a href="#" class="text-brand-purple hover:text-brand-orange">Twitter</a>
            </div>
          </div>
        </div>

        <div>
          <h2 class="text-2xl font-bold mb-6">Send Us a Message</h2>
          <p class="text-sm text-gray-600 mb-6">Or prefer a faster response? <a href="tel:443-327-9292" class="text-brand-orange font-bold hover:underline">Call 443-327-9292</a> now!</p>
          <form action="https://formspree.io/f/mrpzezkg" method="POST" class="space-y-4">
            <div>
              <label class="block font-bold mb-2">Name</label>
              <input type="text" name="name" required class="w-full px-4 py-3 border border-gray-300 rounded-lg focus:outline-none focus:border-brand-purple focus:ring-2 focus:ring-brand-purple/30" />
            </div>
            <div>
              <label class="block font-bold mb-2">Email</label>
              <input type="email" name="email" required class="w-full px-4 py-3 border border-gray-300 rounded-lg focus:outline-none focus:border-brand-purple focus:ring-2 focus:ring-brand-purple/30" />
            </div>
            <div>
              <label class="block font-bold mb-2">Phone</label>
              <input type="tel" name="phone" class="w-full px-4 py-3 border border-gray-300 rounded-lg focus:outline-none focus:border-brand-purple focus:ring-2 focus:ring-brand-purple/30" />
            </div>
            <div>
              <label class="block font-bold mb-2">Message</label>
              <textarea name="message" rows="5" required class="w-full px-4 py-3 border border-gray-300 rounded-lg focus:outline-none focus:border-brand-purple focus:ring-2 focus:ring-brand-purple/30"></textarea>
            </div>
            <button type="submit" class="w-full btn-primary text-center">
              Send Message
            </button>
            <p class="text-center text-sm text-gray-600">Response guaranteed within 24 hours. <a href="tel:443-327-9292" class="text-brand-orange font-bold hover:underline">443-327-9292</a></p>
          </form>
        </div>
      </div>
    </div>
  </section>
</Layout>
