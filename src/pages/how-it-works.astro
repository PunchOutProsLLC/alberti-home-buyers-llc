---
import Layout from '../layouts/Layout.astro';
import Icon from '../components/Icon.astro';
---

<Layout title="How It Works - Alberti Home Buyers LLC">
  <!-- PAGE HERO -->
  <section class="py-24 bg-brand-purple text-white">
    <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <h1 class="text-5xl font-black mb-6">How It Works</h1>
      <p class="text-2xl leading-relaxed">A simple, four-step process to get you a fair cash offer fast &mdash; no repairs, no fees, no waiting.</p>
    </div>
  </section>

  <!-- TRUST BAR -->
  <section class="py-6 bg-brand-cream-soft border-y border-black/5">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 flex flex-wrap items-center justify-center gap-x-10 gap-y-3 text-sm font-semibold text-brand-purple">
      <span class="flex items-center gap-2"><Icon name="lock" class="text-brand-orange" /> Licensed &amp; Insured</span>
      <span class="flex items-center gap-2"><Icon name="clock" class="text-brand-orange" /> 24-Hour Cash Offers</span>
      <span class="flex items-center gap-2"><Icon name="pin" class="text-brand-orange" /> Serving All of Maryland</span>
      <span class="flex items-center gap-2"><Icon name="document" class="text-brand-orange" /> No Fees, No Commissions</span>
    </div>
  </section>
  <!-- BEFORE/AFTER SHOWCASE -->
  <section class="py-20 bg-gradient-to-b from-brand-purple-tint to-white">
    <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
      <h2 class="text-4xl font-bold text-center mb-4">See Real Property Transformations</h2>
      <p class="text-center text-gray-600 mb-4 text-lg">We buy homes in any condition and transform them</p>
      <p class="text-center text-brand-sky text-lg font-bold mb-12">Call <a href="tel:443-327-9292" class="hover:underline">443-327-9292</a> to see more before & afters</p>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-12">
        <!-- SLIDER 1 -->
        <div>
          <h3 class="font-bold text-center mb-4 text-lg">Downtown Baltimore Townhouse</h3>
          <div class="before-after-container">
            <img src="https://images.unsplash.com/photo-1553531088-cbb6f8d6efd9?w=500&h=500&fit=crop" alt="After" class="w-full h-auto">
            <div class="img-before">
              <img src="https://images.unsplash.com/photo-1516455590571-18256e5bb9ff?w=500&h=500&fit=crop" alt="Before" class="w-full h-auto">
            </div>
            <div class="img-slider"></div>
          </div>
          <p class="text-center mt-4 text-sm text-gray-600">Drag to compare | We Paid: <span class="text-brand-orange font-bold">$185,000</span></p>
        </div>

        <!-- SLIDER 2 -->
        <div>
          <h3 class="font-bold text-center mb-4 text-lg">Northeast Property Investment</h3>
          <div class="before-after-container">
            <img src="https://images.unsplash.com/photo-1567620905732-2d1ec7ab7445?w=500&h=500&fit=crop" alt="After" class="w-full h-auto">
            <div class="img-before">
              <img src="https://images.unsplash.com/photo-1576576985261-9df0b8167f5e?w=500&h=500&fit=crop" alt="Before" class="w-full h-auto">
            </div>
            <div class="img-slider"></div>
          </div>
          <p class="text-center mt-4 text-sm text-gray-600">Drag to compare | We Paid: <span class="text-brand-orange font-bold">$245,000</span></p>
        </div>
      </div>
    </div>
  </section>

  <!-- TIMELINE SECTION -->
  <section class="py-16 bg-white">
    <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
      <h2 class="text-4xl font-bold text-center mb-16 text-brand-purple">The Alberti Process: 4 Simple Steps</h2>

      <div class="grid grid-cols-1 md:grid-cols-4 gap-8">
        <!-- Step 1 -->
        <div class="text-center">
          <div class="inline-flex items-center justify-center w-16 h-16 bg-brand-sky text-white rounded-full text-3xl font-bold mb-6">1</div>
          <h3 class="text-xl font-bold text-brand-purple mb-3">Submit Info</h3>
          <p class="text-gray-600 mb-4">Tell us about your property via phone or online form</p>
          <p class="text-sm text-brand-sky font-bold flex items-center justify-center gap-1"><Icon name="clock" /> Takes 5 minutes</p>
        </div>

        <!-- Step 2 -->
        <div class="text-center">
          <div class="inline-flex items-center justify-center w-16 h-16 bg-brand-sky text-white rounded-full text-3xl font-bold mb-6">2</div>
          <h3 class="text-xl font-bold text-brand-purple mb-3">Get Initial Offer</h3>
          <p class="text-gray-600 mb-4">Receive a preliminary cash offer based on your information</p>
          <p class="text-sm text-brand-sky font-bold flex items-center justify-center gap-1"><Icon name="clock" /> Within 24 hours</p>
        </div>

        <!-- Step 3 -->
        <div class="text-center">
          <div class="inline-flex items-center justify-center w-16 h-16 bg-brand-sky text-white rounded-full text-3xl font-bold mb-6">3</div>
          <h3 class="text-xl font-bold text-brand-purple mb-3">Property Inspection</h3>
          <p class="text-gray-600 mb-4">We inspect your home and provide a final cash offer</p>
          <p class="text-sm text-brand-sky font-bold flex items-center justify-center gap-1"><Icon name="clock" /> 1-3 days later</p>
        </div>

        <!-- Step 4 -->
        <div class="text-center">
          <div class="inline-flex items-center justify-center w-16 h-16 bg-brand-sky text-white rounded-full text-3xl font-bold mb-6">4</div>
          <h3 class="text-xl font-bold text-brand-purple mb-3">Close & Get Paid</h3>
          <p class="text-gray-600 mb-4">We handle all paperwork. You choose the closing date</p>
          <p class="text-sm text-brand-sky font-bold flex items-center justify-center gap-1"><Icon name="clock" /> As fast as 7 days</p>
        </div>
      </div>

      <div class="mt-16 text-center">
        <a href="tel:443-327-9292" class="inline-block bg-brand-sky text-white px-12 py-4 rounded-lg font-bold hover:bg-brand-teal transition-all">
          Start Your Journey: 443-327-9292
        </a>
      </div>
    </div>
  </section>

  <section class="py-16 bg-gray-50">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <h2 class="text-4xl font-bold text-center mb-4">See Real Property Transformations</h2>
      <p class="text-center text-brand-sky text-lg font-bold mb-12">Ready to get started? Call <a href="tel:443-327-9292" class="hover:underline">443-327-9292</a> today!</p>

      <div class="space-y-12">
        <div class="card">
          <h2 class="text-2xl font-bold mb-4 text-brand-purple">Step 1: Submit Your Property Information</h2>
          <p class="text-gray-600 mb-4">
            Start by filling out our simple form with basic information about your property. It takes just a few minutes. We'll use this information to conduct an initial assessment. Or call <a href="tel:443-327-9292" class="text-brand-sky font-bold hover:underline">443-327-9292</a> to skip the form.
          </p>
          <p class="text-gray-600">
            No personal commitment required. We're just getting to know your situation.
          </p>
        </div>

        <div class="card">
          <h2 class="text-2xl font-bold mb-4 text-brand-purple">Step 2: Property Inspection</h2>
          <p class="text-gray-600 mb-4">
            One of our experienced home buyers will contact you within 24 hours to schedule a time to visit your property. You can also call us directly at <a href="tel:443-327-9292" class="text-brand-orange font-bold hover:underline">443-327-9292</a> to expedite this step.
          </p>
          <p class="text-gray-600">
            We'll conduct a thorough walkthrough and assessment. You're welcome to be present during the inspection.
          </p>
        </div>

        <div class="card">
          <h2 class="text-2xl font-bold mb-4 text-brand-purple">Step 3: Receive Your Cash Offer</h2>
          <p class="text-gray-600 mb-4">
            Based on our assessment, we'll present you with a fair cash offer. This offer is firm and not contingent on appraisals or financing.
          </p>
          <p class="text-gray-600">
            Take your time to consider it. There's no pressure to accept immediately.
          </p>
        </div>

        <div class="card">
          <h2 class="text-2xl font-bold mb-4 text-brand-purple">Step 4: Close on Your Timeline</h2>
          <p class="text-gray-600 mb-4">
            If you accept our offer, we handle all the paperwork and details. You choose when you want to close – whether that's in 7 days or 7 weeks.
          </p>
          <p class="text-gray-600">
            You'll walk away with cash in your pocket. No commissions. No fees.
          </p>
        </div>
      </div>

      <div class="mt-16 bg-brand-purple text-white p-10 rounded-2xl text-center shadow-xl">
        <h3 class="text-2xl font-bold mb-4">Ready to Get Started?</h3>
        <a href="/" class="inline-block btn-primary px-8 py-3">
          Get Your Free Offer
        </a>
      </div>
    </div>
  </section>
</Layout>
